# ============================================================
#  .env.dev.example  —  шаблон для локальной разработки
#
#  Скопируйте и заполните:
#    cp .env.dev.example .env.dev
#
#  Запуск:
#    docker compose -f docker-compose.dev.yml --env-file .env.dev up -d
# ============================================================

# Пути (Windows — замените на свои)
KEYS_PATH=D:/Projects/OnlineShop/keys
M2_CACHE=C:/Users/Роман/.m2

# PostgreSQL (в dev можно оставить простые)
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Grafana
GRAFANA_PASSWORD=admin
